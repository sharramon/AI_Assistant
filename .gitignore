.venv/
__pycache__/
*.egg-info/
.pytest_cache/
logs/
config/local.toml
config/*.local.toml
# config/ holds your choices: config/<module id>.toml (one per module, may hold your paths) and
# config/permissions.toml (saved grants) are yours, never committed. Shipped: the core's settings
# and the on/off list.
config/*.toml
!config/default.toml
!config/modules.toml
spikes/workspace/
workspace/
.claude/state/
# Personal, machine-specific: your own Claude Code settings and your saved permission grants.
.claude/settings.local.json
data/permissions.toml
# Speech models are downloaded (python -m voice_service download zipformer), never committed.
# The default place is %LOCALAPPDATA%\AI_Assistant\voice_models, outside the repo; this covers a models_dir inside it.
voice_models/
# Secrets and machine-local overrides, anywhere in the tree.
.env
.env.*
*.local.toml
*.local.*
# Personal data: CVs, job and recruiter folders, tokens, saved facts, snips. Never committed.
data/
*.pdf
*.odt
*.docx
rezi_token.json
confirmed_facts.json
snips/
**/snips/
**/Jobs/
**/Recruiters/
# Scratch and temp notes stay on this machine.
docs/scratch/
docs/temp/
scratch/
